{
  "manifest_version": 3,
  "name": "NGA-Neo",
  "version": "1.0.0",
  "description": "NGA论坛显示优化，全面功能增强，让你优雅地摸鱼",
  "author": "NGA-Neo Contributors",
  "homepage_url": "https://github.com/Xe-Persistent/NGA-Neo",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://bbs.nga.cn/*", "*://ngabbs.com/*", "*://nga.178.com/*", "*://g.nga.cn/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://bbs.nga.cn/*", "*://ngabbs.com/*", "*://nga.178.com/*", "*://g.nga.cn/*"],
      "js": ["src/injected/main.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "*://bbs.nga.cn/*",
    "*://ngabbs.com/*",
    "*://nga.178.com/*",
    "*://g.nga.cn/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["excel/*"],
      "matches": ["*://bbs.nga.cn/*", "*://ngabbs.com/*", "*://nga.178.com/*", "*://g.nga.cn/*"]
    }
  ]
}
